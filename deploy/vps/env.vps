# Cópia do /opt/opengym/.env do VPS (sem segredo: a chave de sessão e as VAPID ficam em ./data).
RP_ID=opengym.julianmagossi.com.br
ORIGIN=https://opengym.julianmagossi.com.br
# Só loopback: o nginx do host é a única porta de entrada (o Docker publicaria por cima do ufw).
WEB_PORT=127.0.0.1:8090
RP_NAME=openGym
DEFAULT_LANG=pt-BR
CF_CONNECTING_IP='$http_cf_connecting_ip'
# Sem FIRST_USER_ADMIN: o admin é dado pelo id, não por quem cadastrar primeiro.
# Perfil do Julian (único em data/db.json em 26/11/2026). Cadastro novo só com convite.
ADMIN_UIDS=vRgVu1Jay87pY79-
INVITE_ONLY=1
ALLOW_GUEST=0
